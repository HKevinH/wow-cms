# Copy to .env and adjust. Every value here has a working default for a local
# TrinityCore 5.4.8 server, so a fresh clone runs without editing anything.

# The emulator's auth database. This is the only database the CMS writes to, and
# only on registration and password change.
WOWCMS_AUTH_URL=mysql://root:root@127.0.0.1:3306/auth
WOWCMS_DATABASE_URL=mysql://root:root@127.0.0.1:3306/wowcms

# Where the API listens.
PORT=3001

# Read by the web app at build time.
PUBLIC_API_BASE=http://localhost:3001
PUBLIC_SITE_NAME=WoW CMS

# Which theme the site ships: blizzard or minimal.
PUBLIC_THEME=blizzard
