{
  "name": "@wowcms/api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "//dev": "tsx applies one tsconfig to every file it loads, and this app loads workspace packages outside its own directory, so it is given the root one",
    "dev": "tsx --tsconfig ../../tsconfig.json src/main.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/multipart": "^8.3.1",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-fastify": "^10.4.0",
    "@wowcms/contracts": "workspace:*",
    "@wowcms/core-adapters": "workspace:*",
    "@wowcms/module-accounts": "workspace:*",
    "@wowcms/module-auth": "workspace:*",
    "@wowcms/module-content": "workspace:*",
    "@wowcms/module-media": "workspace:*",
    "@wowcms/module-settings": "workspace:*",
    "@wowcms/module-sdk": "workspace:*",
    "@wowcms/platform-db": "workspace:*",
    "mysql2": "^3.11.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  }
}
