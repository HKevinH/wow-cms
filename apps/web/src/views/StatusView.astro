---
import PublicLayout from '../layouts/PublicLayout.astro';
import CopyLine from '../components/CopyLine.astro';
import { formatUptime } from '@wowcms/contracts';
import { getSiteConfig } from '../config/site';
import { fetchStatus } from '../lib/content';
import { formatDate, useTranslations, type Locale } from '../i18n';

/** Server-rendered rather than prerendered: 'is the realm up' is the one page on
 *  this site whose answer at build time is worthless. */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const site = getSiteConfig();
const status = await fetchStatus();

const uptime = formatUptime(status?.uptimeSeconds ?? null);
const dash = '—';
---

<PublicLayout title={t('status.title')} description={t('status.title')} locale={locale} bare>
  <div class="mx-auto max-w-3xl px-4 py-14 md:py-20">
    <h1 class="mb-10 mt-0 text-3xl uppercase tracking-[0.15em] md:text-4xl">{t('status.title')}</h1>

    <div class="rounded-theme border border-border bg-surface shadow-panel">
      <div class="flex flex-wrap items-center gap-4 border-b border-border px-6 py-5">
        <span
          aria-hidden="true"
          class:list={[
            'h-3 w-3 rounded-full',
            status === null ? 'bg-muted' : status.online ? 'bg-success' : 'bg-danger',
          ]}
        >
        </span>
        <span class="font-display text-lg uppercase tracking-widest text-text">
          {status?.name ?? site.name}
        </span>
        <span
          class:list={[
            'ml-auto text-sm font-semibold uppercase tracking-widest',
            status === null ? 'text-muted' : status.online ? 'text-success' : 'text-danger',
          ]}
        >
          {status === null ? t('status.unknown') : status.online ? t('status.online') : t('status.offline')}
        </span>
      </div>

      <dl class="m-0 grid gap-px bg-border sm:grid-cols-3">
        <div class="bg-surface px-6 py-5">
          <dt class="m-0 text-xs uppercase tracking-widest text-muted">{t('status.players')}</dt>
          <dd class="m-0 mt-1 font-display text-2xl text-highlight">
            {status?.playersOnline ?? dash}
          </dd>
        </div>
        <div class="bg-surface px-6 py-5">
          <dt class="m-0 text-xs uppercase tracking-widest text-muted">{t('status.uptime')}</dt>
          <dd class="m-0 mt-1 font-display text-2xl text-highlight">{uptime ?? dash}</dd>
        </div>
        <div class="bg-surface px-6 py-5">
          <dt class="m-0 text-xs uppercase tracking-widest text-muted">{t('status.updated')}</dt>
          <dd class="m-0 mt-1 text-sm text-muted">
            {status ? formatDate(status.checkedAt, locale) : dash}
          </dd>
        </div>
      </dl>
    </div>

    <h2 class="mb-4 mt-12 text-lg uppercase tracking-wider text-highlight">{t('status.realm')}</h2>
    <CopyLine
      value={site.realmlist}
      copyLabel={t('connect.copy')}
      copiedLabel={t('connect.copied')}
    />
  </div>
</PublicLayout>
