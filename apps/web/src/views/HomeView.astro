---
import PublicLayout from '../layouts/PublicLayout.astro';
import HeroVideo from '../components/HeroVideo.astro';
import FeatureIcons from '../components/FeatureIcons.astro';
import FeaturePanel from '../components/FeaturePanel.astro';
import Faq from '../components/Faq.astro';
import NewsCard from '../components/NewsCard.astro';
import Button from '../components/Button.astro';
import { getSiteConfig } from '../config/site';
import { fetchNews } from '../lib/content';
import { path, useTranslations, type Locale } from '../i18n';

/** The landing page, written once and rendered by the page file of each locale.
 *  Keeping the body here rather than in `pages/` is what stops the Spanish and
 *  English front pages drifting apart every time a section is added. */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const { media } = getSiteConfig();
const news = await fetchNews(locale, 3);

const highlights = [
  { icon: media.icons.scenarios, title: t('features.scenarios.title'), body: t('features.scenarios.body') },
  { icon: media.icons.challenges, title: t('features.challenges.title'), body: t('features.challenges.body') },
  { icon: media.icons.pets, title: t('features.pets.title'), body: t('features.pets.body') },
  { icon: media.icons.pandaren, title: t('features.pandaren.title'), body: t('features.pandaren.body') },
];

const panels = [
  { title: t('panels.levelcap.title'), body: t('panels.levelcap.body'), image: media.cards.levelCap },
  { title: t('panels.talents.title'), body: t('panels.talents.body'), image: media.cards.talents },
  { title: t('panels.timeless.title'), body: t('panels.timeless.body'), image: media.cards.timeless },
  { title: t('panels.alts.title'), body: t('panels.alts.body'), image: media.cards.alts },
];

const faq = [
  { question: t('faq.client.q'), answer: t('faq.client.a') },
  { question: t('faq.account.q'), answer: t('faq.account.a') },
  { question: t('faq.rates.q'), answer: t('faq.rates.a') },
  { question: t('faq.password.q'), answer: t('faq.password.a') },
];
---

<PublicLayout title={t('nav.home')} description={t('hero.body')} locale={locale} bare>
  <HeroVideo locale={locale} />

  <FeatureIcons heading={t('features.title')} items={highlights} />

  <section class="band bg-panel-band">
    <h2 class="sr-only">{t('panels.title')}</h2>
    {panels.map((panel, index) => <FeaturePanel {...panel} flip={index % 2 === 1} />)}
  </section>

  <section class="mx-auto max-w-measure px-4 py-16 md:py-24">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-4 border-b border-border pb-4">
      <h2 class="m-0 text-2xl uppercase tracking-[0.2em] md:text-3xl">{t('news.title')}</h2>
      <Button href={path('news', locale)} variant="outline">{t('news.all')}</Button>
    </div>

    {
      news.length === 0 ? (
        <p class="m-0 text-muted">{t('news.empty')}</p>
      ) : (
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {news.map((item) => (
            <NewsCard item={item} locale={locale} />
          ))}
        </div>
      )
    }
  </section>

  <Faq heading={t('connect.faq')} entries={faq} />
</PublicLayout>
