---
/** The row of circular icons that sits directly under the masthead. Each entry
 *  is a name, an icon and a line of copy; the component owns nothing else, so a
 *  page decides which four of them to show. */
export interface FeatureIcon {
  icon?: string;
  title: string;
  body: string;
}

interface Props {
  heading?: string;
  description?: string;
  background?: string;
  mobileBackground?: string;
  items: FeatureIcon[];
}

const { heading, description, background, mobileBackground, items } = Astro.props;
---

<section
  class="border-b border-border bg-[#430408] bg-cover bg-center"
  style={background ? `--features-background: url('${background}'); --features-background-mobile: url('${mobileBackground ?? background}')` : undefined}
>
  <style>
    section {
      background-image: linear-gradient(rgba(67, 4, 8, .84), rgba(67, 4, 8, .92)), var(--features-background);
    }

    @media (max-width: 767px) {
      section {
        background-image: linear-gradient(rgba(67, 4, 8, .84), rgba(67, 4, 8, .92)), var(--features-background-mobile);
      }
    }
  </style>
  <div class="mx-auto max-w-measure px-4 py-16 md:py-24">
    {
      heading && (
        <h2 class="mb-5 mt-0 text-center font-serif text-4xl font-semibold tracking-wide text-[#f1d5a3] md:text-5xl">
          {heading}
        </h2>
      )
    }

    {description && <p class="mx-auto mb-12 max-w-3xl text-center text-lg leading-relaxed text-white/90">{description}</p>}

    <ul class="m-0 grid list-none gap-x-14 gap-y-12 p-0 md:grid-cols-2">
      {
        items.map((item) => (
          <li class="grid grid-cols-[3.5rem_1fr] items-start gap-4">
            {item.icon ? (
              <img
                src={item.icon}
                alt=""
                aria-hidden="true"
                width="96"
                height="96"
                loading="lazy"
                class="h-14 w-14 rounded-full border-2 border-[#d8a900] object-cover shadow-panel"
              />
            ) : (
              /* No artwork configured: a ring keeps the rhythm of the row rather
                 than collapsing it into a text list. */
              <span
                aria-hidden="true"
                class="block h-14 w-14 rounded-full border-2 border-[#d8a900] bg-black/20"
              />
            )}

            <div>
              <h3 class="mb-1 mt-0 font-serif text-xl font-semibold leading-tight text-[#f1d5a3]">{item.title}</h3>
              <p class="m-0 text-base leading-relaxed text-white/90">{item.body}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
