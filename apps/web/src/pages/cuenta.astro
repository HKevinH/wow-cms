---
import AccountView from '../views/AccountView.astro';
import { getViewer } from '../lib/session';
import { path } from '../i18n';

/** Server-rendered: it shows who the reader is, which cannot be decided at build
 *  time. Anonymous readers are sent to the login form rather than shown an empty
 *  page. */
export const prerender = false;

const viewer = await getViewer(Astro);
if (viewer === null) {
  return Astro.redirect(path('login', 'es'));
}
---

<AccountView locale="es" viewer={viewer} />
