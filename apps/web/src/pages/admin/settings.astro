---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getViewer, requirePermission } from '../../lib/session';
export const prerender = false;
const denied = requirePermission(Astro, await getViewer(Astro), 'settings.manage');
if (denied) return denied;
---
<DashboardLayout title="Settings">
  <form id="settings-form" class="grid gap-6">
    <div id="settings-groups" class="grid gap-6"></div>
    <div class="flex items-center gap-4"><button id="settings-save" class="rounded bg-accent px-5 py-2">Save settings</button><p id="settings-result" role="status" class="m-0 text-sm text-muted"></p></div>
  </form>
</DashboardLayout>
<script>
  import { apiFetch } from '../../lib/api';
  type Field = { key: string; label: string; type: string; description?: string };
  const form = document.querySelector<HTMLFormElement>('#settings-form'); const groups = document.querySelector<HTMLElement>('#settings-groups'); const result = document.querySelector<HTMLElement>('#settings-result'); const es = new URLSearchParams(window.location.search).get('lang') === 'es';
  const copy = es ? { identity: 'Identidad del sitio', identityHelp: 'Nombre y apariencia pública del CMS.', connection: 'Conexión del realm', connectionHelp: 'Puertos usados por los servicios del servidor.', commerce: 'Store y enlaces', commerceHelp: 'URLs públicas que aparecerán en el sitio.', media: 'Media', mediaHelp: 'Recursos visuales del sitio.', save: 'Guardar configuración', saving: 'Guardando…', saved: 'Configuración guardada.', error: 'No se pudo guardar la configuración.' } : { identity: 'Site identity', identityHelp: 'Public name and appearance of the CMS.', connection: 'Realm connection', connectionHelp: 'Ports used by the server services.', commerce: 'Store and links', commerceHelp: 'Public URLs shown across the site.', media: 'Media', mediaHelp: 'Visual resources used by the site.', save: 'Save settings', saving: 'Saving…', saved: 'Settings saved.', error: 'Unable to save settings.' };
  const groupsConfig = [{ title: copy.identity, help: copy.identityHelp, keys: ['siteName', 'serverDescription', 'expansion', 'theme', 'realmlist'] }, { title: copy.connection, help: copy.connectionHelp, keys: ['authPort', 'worldPort', 'soapPort'] }, { title: copy.commerce, help: copy.commerceHelp, keys: ['storeUrl', 'discordUrl', 'rulesUrl', 'contactUrl'] }, { title: copy.media, help: copy.mediaHelp, keys: ['logoUrl', 'heroVideoUrl', 'heroPosterUrl'] }];
  const escape = (value: string) => { const node = document.createElement('span'); node.textContent = value; return node.innerHTML; };
  const control = (field: Field, value: string) => { const safe = escape(value); if (field.key === 'serverDescription') return `<textarea name="${field.key}" class="min-h-28 w-full rounded border p-2">${safe}</textarea>`; if (field.key === 'theme') return `<select name="theme" class="w-full rounded border p-2"><option value="pandaria" ${value === 'pandaria' ? 'selected' : ''}>Pandaria</option><option value="blizzard" ${value === 'blizzard' ? 'selected' : ''}>Blizzard</option><option value="minimal" ${value === 'minimal' ? 'selected' : ''}>Minimal</option></select>`; const type = field.type === 'number' ? 'number' : field.type === 'url' || field.type === 'media' ? 'url' : 'text'; return `<input name="${field.key}" type="${type}" value="${safe}" class="w-full rounded border p-2" />`; };
  const data = await apiFetch<{ schema: { fields: Field[] }; values: Record<string, string> }>('/api/m/settings'); const byKey = new Map(data.schema.fields.map((field) => [field.key, field])); if (groups) groups.innerHTML = groupsConfig.map((group) => `<section class="rounded-theme border border-border bg-surface p-6 shadow-panel"><h2 class="m-0 text-lg">${group.title}</h2><p class="mb-5 mt-1 text-sm text-muted">${group.help}</p><div class="grid gap-4 md:grid-cols-2">${group.keys.map((key) => { const field = byKey.get(key); return field ? `<label class="grid gap-1 text-sm ${key === 'serverDescription' ? 'md:col-span-2' : ''}"><span class="font-medium">${field.label}</span>${control(field, data.values[key] ?? '')}${field.description ? `<small class="text-muted">${field.description}</small>` : ''}</label>` : ''; }).join('')}</div></section>`).join(''); const save = document.querySelector<HTMLButtonElement>('#settings-save'); if (save) save.textContent = copy.save; form?.addEventListener('submit', async (event) => { event.preventDefault(); if (result) result.textContent = copy.saving; try { await apiFetch('/api/m/settings', { method: 'PUT', body: JSON.stringify(Object.fromEntries(new FormData(form))) }); if (result) result.textContent = copy.saved; } catch { if (result) result.textContent = copy.error; } });
</script>
