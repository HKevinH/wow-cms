---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getViewer, requirePermission } from '../../lib/session';
export const prerender = false;
const denied = requirePermission(Astro, await getViewer(Astro), 'store.manage');
if (denied) return denied;
---
<DashboardLayout title="Store">
  <div class="grid gap-6 lg:grid-cols-2">
    <form id="store-config" class="grid gap-4 rounded-theme border border-border bg-surface p-6"><h2 class="m-0 text-lg">Store configuration</h2><label class="flex items-center gap-3"><input name="enabled" type="checkbox" /> Enable store</label><label class="grid gap-1">Currency<input name="currency" value="USD" class="rounded border p-2" /></label><button class="rounded bg-accent px-4 py-2">Save</button></form>
    <form id="payment" class="grid gap-4 rounded-theme border border-border bg-surface p-6"><h2 class="m-0 text-lg">Payment method</h2><input name="name" required placeholder="Name" class="rounded border p-2" /><input name="checkoutUrl" placeholder="Checkout URL" class="rounded border p-2" /><textarea name="description" placeholder="Description" class="rounded border p-2"></textarea><button class="rounded bg-accent px-4 py-2">Add payment method</button></form>
  </div>
  <form id="item" class="mt-6 grid gap-4 rounded-theme border border-border bg-surface p-6"><h2 class="m-0 text-lg">Game item catalog</h2><div class="grid gap-4 md:grid-cols-[12rem_1fr_auto]"><select id="item-realm" class="rounded border p-2"><option value="">Realm</option></select><input id="item-search" placeholder="Search by item name or ID" class="rounded border p-2" /><button id="item-search-button" type="button" class="rounded border px-4 py-2">Search</button></div><div id="item-results" class="grid gap-2"></div><article id="item-preview" hidden class="grid gap-3 rounded border border-accent/40 bg-black/20 p-4 md:grid-cols-[5rem_1fr]"><div id="item-preview-icon" class="grid h-16 w-16 place-items-center rounded border text-2xl">?</div><div><h3 id="item-preview-name" class="m-0 text-lg"></h3><p id="item-preview-meta" class="m-0 text-sm text-muted"></p><p id="item-preview-description" class="m-0 mt-2 text-sm"></p></div></article><div class="grid gap-4 md:grid-cols-2"><input name="itemId" required type="number" placeholder="Game item ID" class="rounded border p-2" /><input name="name" required placeholder="Item name" class="rounded border p-2" /><input name="iconUrl" placeholder="Local icon URL (optional)" class="rounded border p-2" /><input name="priceDonorPoints" type="number" placeholder="Donor points" class="rounded border p-2" /></div><input type="hidden" name="realmId" /><input type="hidden" name="displayId" value="0" /><input type="hidden" name="inventoryType" value="0" /><textarea name="description" placeholder="Description and inspection notes" class="rounded border p-2"></textarea><p id="item-quality" class="m-0 text-sm"></p><button class="w-fit rounded bg-accent px-4 py-2">Publish item</button></form>
</DashboardLayout>
<script>
  import { apiFetch } from '../../lib/api';
  const config = document.querySelector<HTMLFormElement>('#store-config'); const payment = document.querySelector<HTMLFormElement>('#payment'); const item = document.querySelector<HTMLFormElement>('#item'); const realm = document.querySelector<HTMLSelectElement>('#item-realm'); const results = document.querySelector<HTMLElement>('#item-results'); const search = document.querySelector<HTMLInputElement>('#item-search'); const preview = document.querySelector<HTMLElement>('#item-preview');
  void apiFetch<Array<{ id: number; name: string }>>('/api/m/realms').then((realms) => { if (realm) realm.innerHTML = realms.filter((entry) => entry.id).map((entry) => `<option value="${entry.id}">${entry.name}</option>`).join(''); });
  document.querySelector<HTMLButtonElement>('#item-search-button')?.addEventListener('click', async () => { if (!realm?.value || !search?.value) return; const found = await apiFetch<Array<{ itemId: number; name: string; qualityColor: string; quality: number; itemLevel: number; requiredLevel: number; description: string; displayId: number; inventoryType: number }>>(`/api/m/store/admin/item-search?q=${encodeURIComponent(search.value)}&realmId=${realm.value}`); if (results) results.innerHTML = found.map((entry) => `<button type="button" data-item='${JSON.stringify(entry)}' class="text-left rounded border p-3 hover:border-accent"><span style="color:${entry.qualityColor}">${entry.name}</span> <small>#${entry.itemId} · ilvl ${entry.itemLevel}</small></button>`).join('') || '<p class="text-muted">No results</p>'; results?.querySelectorAll<HTMLButtonElement>('[data-item]').forEach((button) => button.addEventListener('click', () => { const entry = JSON.parse(button.dataset.item ?? '{}'); (item?.elements.namedItem('itemId') as HTMLInputElement).value = entry.itemId; (item?.elements.namedItem('name') as HTMLInputElement).value = entry.name; (item?.elements.namedItem('description') as HTMLTextAreaElement).value = entry.description; (item?.elements.namedItem('realmId') as HTMLInputElement).value = realm.value; (item?.elements.namedItem('displayId') as HTMLInputElement).value = String(entry.displayId ?? 0); (item?.elements.namedItem('inventoryType') as HTMLInputElement).value = String(entry.inventoryType ?? 0); const quality = document.querySelector<HTMLElement>('#item-quality'); if (quality) { quality.textContent = `Quality ${entry.quality} · Item level ${entry.itemLevel} · Required level ${entry.requiredLevel}`; quality.style.color = entry.qualityColor; } if (preview) preview.hidden = false; const previewName = document.querySelector<HTMLElement>('#item-preview-name'); const previewMeta = document.querySelector<HTMLElement>('#item-preview-meta'); const previewDescription = document.querySelector<HTMLElement>('#item-preview-description'); const previewIcon = document.querySelector<HTMLElement>('#item-preview-icon'); if (previewName) { previewName.textContent = entry.name; previewName.style.color = entry.qualityColor; } if (previewMeta) previewMeta.textContent = `#${entry.itemId} · Calidad ${entry.quality} · ilvl ${entry.itemLevel} · Nivel requerido ${entry.requiredLevel}`; if (previewDescription) previewDescription.textContent = entry.description || 'Sin descripción'; if (previewIcon) { previewIcon.textContent = '★'; previewIcon.style.color = entry.qualityColor; previewIcon.style.borderColor = entry.qualityColor; } })); });
  void apiFetch<{ enabled: boolean; currency: string }>('/api/m/store/config').then((v) => { const enabled = config?.elements.namedItem('enabled') as HTMLInputElement | null; const currency = config?.elements.namedItem('currency') as HTMLInputElement | null; if (enabled) enabled.checked = v.enabled; if (currency) currency.value = v.currency; });
  config?.addEventListener('submit', async (e) => { e.preventDefault(); await apiFetch('/api/m/store/admin/config', { method: 'PUT', body: JSON.stringify({ enabled: (config.elements.namedItem('enabled') as HTMLInputElement).checked, currency: (config.elements.namedItem('currency') as HTMLInputElement).value }) }); });
  payment?.addEventListener('submit', async (e) => { e.preventDefault(); await apiFetch('/api/m/store/admin/payment-methods', { method: 'POST', body: JSON.stringify(Object.fromEntries(new FormData(payment))) }); });
  item?.addEventListener('submit', async (e) => { e.preventDefault(); await apiFetch('/api/m/store/admin/items', { method: 'POST', body: JSON.stringify(Object.fromEntries(new FormData(item))) }); });
</script>
