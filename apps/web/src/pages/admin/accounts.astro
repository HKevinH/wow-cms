---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
export const prerender = false;
---
<DashboardLayout title="Accounts"><div id="accounts">Loading…</div></DashboardLayout>
<script>
  import { apiFetch } from '../../lib/api'; const target = document.querySelector<HTMLElement>('#accounts'); const page = await apiFetch<{items:{username:string;email:string;roles:string[]}[]}>('/api/accounts?limit=100'); if (target) target.innerHTML = `<table><thead><tr><th>Username</th><th>Email</th><th>Roles</th></tr></thead><tbody>${page.items.map((a) => `<tr><td>${a.username}</td><td>${a.email}</td><td>${a.roles.join(', ') || 'none'}</td></tr>`).join('')}</tbody></table>`;
</script>
