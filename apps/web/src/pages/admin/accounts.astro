---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import AccountsTable from '../../components/admin/AccountsTable.astro';
import { getViewer, requirePermission } from '../../lib/session';
export const prerender = false;
const denied = requirePermission(Astro, await getViewer(Astro), 'accounts.manage');
if (denied) return denied;
---
<DashboardLayout title="Accounts"><AccountsTable /></DashboardLayout>
<script>
  import { apiFetch } from '../../lib/api';
  type AccountPage = { items: { username: string; email: string; roles: string[] }[]; total: number; limit: number; offset: number };
  const es = new URLSearchParams(window.location.search).get('lang') === 'es'; const copy = es ? { title: 'Cuentas', loading: 'Cargando cuentas…', all: 'Usuario o correo', username: 'Usuario', email: 'Correo', roles: 'Roles', previous: 'Anterior', next: 'Siguiente', found: 'cuenta(s) encontrada(s)', empty: 'No se encontraron cuentas.', noRoles: 'Sin roles', error: 'No se pudieron cargar las cuentas.' } : { title: 'Accounts', loading: 'Loading accounts…', all: 'Username or email', username: 'Username', email: 'Email', roles: 'Roles', previous: 'Previous', next: 'Next', found: 'account(s) found', empty: 'No accounts found.', noRoles: 'No roles', error: 'Unable to load accounts.' };
  const setText = (selector: string, value: string) => { const node = document.querySelector<HTMLElement>(selector); if (node) node.textContent = value; }; setText('#accounts-summary', copy.loading); setText('#accounts-prev', copy.previous); setText('#accounts-next', copy.next); document.querySelector<HTMLInputElement>('#account-search')?.setAttribute('placeholder', es ? 'Buscar cuentas…' : 'Search accounts…'); const filter = document.querySelector<HTMLSelectElement>('#account-filter'); if (filter) filter.innerHTML = `<option value="">${copy.all}</option><option value="username">${copy.username}</option><option value="email">${copy.email}</option>`;
  const body = document.querySelector<HTMLElement>('#accounts-body'); const search = document.querySelector<HTMLInputElement>('#account-search'); const summary = document.querySelector<HTMLElement>('#accounts-summary'); const pageLabel = document.querySelector<HTMLElement>('#accounts-page'); const error = document.querySelector<HTMLElement>('#accounts-error'); const previous = document.querySelector<HTMLButtonElement>('#accounts-prev'); const next = document.querySelector<HTMLButtonElement>('#accounts-next'); let offset = 0; const limit = 25;
  const escape = (value: string) => { const node = document.createElement('span'); node.textContent = value; return node.innerHTML; };
  const load = async () => { if (!body) return; if (error) error.textContent = ''; body.innerHTML = `<tr><td colspan="3" class="px-3 py-8 text-center text-muted">${copy.loading}</td></tr>`; try { const params = new URLSearchParams({ limit: String(limit), offset: String(offset) }); if (search?.value.trim()) params.set('search', search.value.trim()); if (filter?.value) params.set('field', filter.value); const page = await apiFetch<AccountPage>(`/api/m/accounts?${params}`); body.innerHTML = page.items.length ? page.items.map((account) => `<tr class="border-b border-border"><td class="px-3 py-3 font-medium">${escape(account.username)}</td><td class="px-3 py-3 text-muted">${escape(account.email || '—')}</td><td class="px-3 py-3 text-muted">${escape(account.roles.join(', ') || copy.noRoles)}</td></tr>`).join('') : `<tr><td colspan="3" class="px-3 py-8 text-center text-muted">${copy.empty}</td></tr>`; if (summary) summary.textContent = `${page.total} ${copy.found}`; if (pageLabel) pageLabel.textContent = `${es ? 'Página' : 'Page'} ${Math.floor(offset / limit) + 1}`; if (previous) previous.disabled = offset === 0; if (next) next.disabled = offset + page.items.length >= page.total; } catch (cause) { body.innerHTML = ''; if (error) error.textContent = cause instanceof Error ? cause.message : copy.error; } };
  let timer: ReturnType<typeof setTimeout>; search?.addEventListener('input', () => { clearTimeout(timer); timer = setTimeout(() => { offset = 0; void load(); }, 250); }); filter?.addEventListener('change', () => { offset = 0; void load(); }); previous?.addEventListener('click', () => { offset = Math.max(0, offset - limit); void load(); }); next?.addEventListener('click', () => { offset += limit; void load(); }); void load();
</script>
