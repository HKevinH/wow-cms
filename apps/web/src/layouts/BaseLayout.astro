---
import Seo from "../components/Seo.astro";
import { resolveTheme } from "../themes";
import { DEFAULT_LOCALE, type Locale } from "../i18n";
import "../themes/base.css";
import "../themes/pandaria.css";
import "../themes/blizzard.css";
import "../themes/minimal.css";

/** The only place the document shell exists. Public pages and the dashboard both
 *  build on this, so meta tags, theme wiring and the base stylesheet are written
 *  once. */
interface Props {
  title: string;
  description?: string;
  canonical?: string;
  locale?: Locale;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  locale = DEFAULT_LOCALE,
  image,
  noindex,
} = Astro.props;
const theme = resolveTheme();
const publicApiBase = import.meta.env.PUBLIC_API_BASE ?? "http://localhost:3001";
---

<!doctype html>
<html lang={locale} data-site-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo
      title={title}
      description={description}
      canonical={canonical}
      locale={locale}
      image={image}
      noindex={noindex}
    />
  </head>
  <body class="min-h-screen">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-theme focus:bg-accent focus:px-4 focus:py-2 focus:text-accent-text"
    >
      {locale === "es" ? "Saltar al contenido" : "Skip to content"}
    </a>

    <slot />

    <script define:vars={{ publicApiBase }}>
      const apiBase = publicApiBase;
      const path = window.location.pathname;
      const isInstallPath = path === "/install" || path === "/install/";
      const readStatus = () =>
        fetch(`${apiBase}/api/install/status`, { credentials: "include" }).then(
          (response) => (response.ok ? response.json() : null),
        );
      readStatus()
        .then((config) => {
          if (!config) return;
          if (!config.installed && !isInstallPath) {
            window.location.replace("/install");
            return;
          }
          if (config.installed && isInstallPath) {
            window.location.replace("/");
            return;
          }
          if (!config.installed) return;
          return fetch(`${apiBase}/api/m/settings/public`, {
            credentials: "include",
          }).then((response) => (response.ok ? response.json() : null));
        })
        .then((config) => {
          if (!config?.values) return;
          document.querySelectorAll("[data-site-name]").forEach((node) => {
            node.textContent = config.values.siteName;
          });
          document
            .querySelectorAll("[data-site-description]")
            .forEach((node) => {
              node.textContent = config.values.serverDescription;
            });
          document.querySelectorAll("[data-site-meta]").forEach((node) => {
            node.textContent = `${config.values.expansion} · Auth ${config.values.authPort} · World ${config.values.worldPort}`;
          });
          document.querySelectorAll("[data-site-store]").forEach((node) => {
            node.setAttribute("href", config.values.storeUrl);
          });
          document.querySelectorAll("[data-site-link]").forEach((node) => {
            const key = node.getAttribute("data-site-link");
            const value =
              key === "discord"
                ? config.values.discordUrl
                : key === "rules"
                  ? config.values.rulesUrl
                  : config.values.contactUrl;
            if (value) {
              node.setAttribute("href", value);
              node.removeAttribute("hidden");
            } else {
              node.setAttribute("hidden", "");
            }
          });
          document.documentElement.dataset.siteTheme = config.values.theme;
        })
        .catch(() => undefined);
    </script>

    <script is:inline>
      // Applied before paint so a reader who chose light or dark never sees the
      // other one flash first.
      const stored = localStorage.getItem("theme");
      if (stored === "dark" || stored === "light") {
        document.documentElement.setAttribute("data-theme", stored);
      }
    </script>
  </body>
</html>
