---
import BaseLayout from './BaseLayout.astro';

/** Chrome for the administration area. The navigation is data, not markup,
 *  because modules contribute their own sections: the core supplies the shell
 *  and every functional screen arrives from a module. */
export interface DashboardNavItem {
  path: string;
  title: string;
}

interface Props {
  title: string;
  /** Replaced by the sections of the loaded modules once the API reports them. */
  sections?: DashboardNavItem[];
}

const { title, sections = [
  { path: '/admin/news', title: 'News' },
  { path: '/admin/media', title: 'Media' },
  { path: '/admin/settings', title: 'Settings' },
  { path: '/admin/accounts', title: 'Accounts' },
  { path: '/admin/diagnostics', title: 'Diagnostics' },
] } = Astro.props;

// A static build serves /admin/diagnostics/ with a trailing slash while the
// declared paths carry none, so both sides are normalised before comparing.
const normalise = (path: string) => path.replace(/\/$/, '') || '/';
const current = normalise(Astro.url.pathname);
const siteName = 'WoW CMS';
---

<BaseLayout title={title} noindex>
  <div class="grid min-h-screen grid-cols-1 md:grid-cols-[16rem_1fr]">
    <aside class="border-b border-border bg-surface p-4 md:border-b-0 md:border-r">
      <a href="/" class="font-display text-sm font-bold uppercase tracking-widest text-accent no-underline">
        {siteName}
      </a>
      <p class="mb-4 mt-6 text-xs uppercase tracking-widest text-muted">Administration</p>

      <nav>
        <ul class="m-0 flex list-none flex-col gap-1 p-0">
          {
            sections.map((section) => (
              <li>
                <a
                  href={section.path}
                  aria-current={current === normalise(section.path) ? 'page' : undefined}
                  class="block rounded-theme px-3 py-2 text-sm no-underline text-muted hover:text-accent aria-[current=page]:bg-accent aria-[current=page]:text-accent-text"
                >
                  {section.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </aside>

    <main class="overflow-x-auto p-6 md:p-10">
      <h1 class="mb-6 mt-0 text-2xl">{title}</h1>
      <slot />
    </main>
  </div>
</BaseLayout>
