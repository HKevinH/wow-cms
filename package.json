{
  "name": "wow-cms",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @wowcms/api dev",
    "dev:web": "pnpm --filter @wowcms/web dev",
    "build": "pnpm -r --parallel build",
    "media:fetch": "pnpm --filter @wowcms/web media:fetch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
